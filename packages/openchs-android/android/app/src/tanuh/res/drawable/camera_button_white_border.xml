<?xml version="1.0" encoding="utf-8" ?>
<!-- "Retake" button — outlined style with rounded corners + ripple, matching the app-wide
     borderRadius: 8 button convention used across the RN UI. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/camera_ripple_white">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/camera_white" />
            <corners android:radius="@dimen/camera_button_corner_radius" />
        </shape>
    </item>
</ripple>
